{
  "name": "retail-ab-lab-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "python ../scripts/build_web_data.py",
    "api": "python -m uvicorn api.index:app --port 8000 --reload --reload-dir ../src",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "pylib": "rm -rf pylib && mkdir -p pylib/retaillab && cp ../src/retaillab/__init__.py ../src/retaillab/api.py ../src/retaillab/pricing.py ../src/retaillab/decision.py pylib/retaillab/",
    "build:vercel": "python3 -m venv .pyenv && .pyenv/bin/pip install --quiet -r ../requirements-web.txt && .pyenv/bin/python ../scripts/build_web_data.py && npm run pylib && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4"
  }
}
